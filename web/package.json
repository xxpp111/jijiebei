{
  "name": "jjb-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "e2e:ui": "npm run build --silent && node e2e/ui-smoke.mjs",
    "e2e:r6": "npm run build --silent && node e2e/r6-doubles-downstream.mjs",
    "e2e:core": "npm run build --silent && node e2e/run.mjs && node e2e/codec.mjs && node e2e/bp-rules.mjs && node e2e/auto-post.mjs",
    "e2e:back": "cd ../backend && go build -o pocketbase . && cd ../web && npm run build --silent && node e2e/rankings-board.mjs && node e2e/practice-post.mjs && node e2e/record-fullstack.mjs",
    "snap:visual": "npm run build --silent && node scripts/snap-verify.mjs",
    "preview": "vite preview --port 7788",
    "test:unit": "vitest run",
    "test:drift": "node scripts/drift-check.mjs",
    "test:docs-drift": "node scripts/docs-drift-check.mjs",
    "test:wiki": "node --test scripts/wiki-governance.test.mjs",
    "test:migrations": "node ../backend/scripts/check-migrations.test.mjs",
    "test:back": "cd ../backend && go test ./...",
    "test": "npm run test:unit && npm run test:drift && npm run test:docs-drift && npm run test:wiki && npm run test:migrations && npm run test:back"
  },
  "dependencies": {
    "@zumer/snapdom": "^2.12.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.61.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
